APP_ENV=dev
APP_SECRET=domiciliaria_secret_key_change_in_prod

DATABASE_URL="postgresql://app:secret@postgres:5432/domiciliaria?serverVersion=16&charset=utf8"

MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages

MAILER_DSN=null://null

REDIS_URL=redis://redis:6379

# Multi-tenancy
TENANT_DB_USER=app
TENANT_DB_PASSWORD=secret
TENANT_DB_HOST=postgres

# Seguridad — Cifrado AES-256 (generar con: php bin/console app:security:generate-key)
# NUNCA commitear la clave real. En Render/prod configurar como variable de entorno.
# Generar con: php bin/console app:security:generate-key
# En producción configurar como variable de entorno en Render
APP_ENCRYPTION_KEY=

# PostgreSQL (para backups)
PGHOST=postgres
PGPORT=5432
PGUSER=app
PGPASSWORD=secret

# S3 para backups cifrados (opcional en dev)
AWS_S3_BUCKET=
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
