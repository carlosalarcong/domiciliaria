<header class="top-header">
    <div class="flex-grow-1">
        <h6 class="mb-0 text-muted fw-normal">
            {% block page_title %}{% endblock %}
        </h6>
    </div>
    <div class="d-flex align-items-center gap-3">
        <div class="dropdown">
            <button class="btn btn-sm btn-light dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width:32px;height:32px;font-size:0.8rem">
                    {{ app.user.nombre|first|upper }}{{ app.user.apellido|first|upper }}
                </div>
                <span class="d-none d-md-inline">{{ app.user.nombreCompleto }}</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow">
                <li>
                    <span class="dropdown-item-text small text-muted">
                        <i class="bi bi-shield-fill me-1"></i>{{ app.user.rolEtiqueta }}
                    </span>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item" href="{{ path('app_logout') }}">
                        <i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión
                    </a>
                </li>
            </ul>
        </div>
    </div>
</header>
