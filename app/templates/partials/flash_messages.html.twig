{% for type, messages in app.flashes %}
    {% for message in messages %}
        {% set bsType = type == 'error' ? 'danger' : type %}
        {% set icon = type == 'success' ? 'check-circle-fill' : (type == 'error' ? 'x-circle-fill' : (type == 'warning' ? 'exclamation-triangle-fill' : 'info-circle-fill')) %}
        <div class="alert alert-{{ bsType }} alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-{{ icon }}"></i>
            <div>{{ message }}</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
{% endfor %}
