<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nueva contraseña — Atención Domiciliaria</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #1a2332 0%, #2d3748 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .card { width: 100%; max-width: 420px; border: none; border-radius: 1rem; box-shadow: 0 20px 60px rgba(0,0,0,0.3); }
        .card-header { background: linear-gradient(135deg, #3182ce, #2b6cb0); border-radius: 1rem 1rem 0 0; padding: 2rem; text-align: center; color: white; }
        .toggle-password { cursor: pointer; border-left: 0; background: white; }
        .toggle-password:hover { color: #3182ce; }
    </style>
</head>
<body>
<div class="card">
    <div class="card-header">
        <i class="bi bi-shield-lock-fill" style="font-size:2.5rem"></i>
        <h4 class="mt-2 mb-0 fw-bold">Nueva contraseña</h4>
        <small class="opacity-75">Elige una contraseña segura</small>
    </div>
    <div class="card-body p-4">
        {{ form_start(resetForm, {attr: {novalidate: 'novalidate'}}) }}
            <div class="mb-3">
                <label class="form-label fw-semibold">Nueva contraseña</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    {{ form_widget(resetForm.plainPassword.first, {attr: {id: 'password1', class: 'form-control'}}) }}
                    <button type="button" class="btn btn-outline-secondary toggle-password"
                            onclick="togglePass('password1','icon1')" tabindex="-1">
                        <i class="bi bi-eye" id="icon1"></i>
                    </button>
                </div>
                {{ form_errors(resetForm.plainPassword.first) }}
                <div class="form-text text-muted">Mínimo 8 caracteres.</div>
            </div>
            <div class="mb-4">
                <label class="form-label fw-semibold">Confirmar contraseña</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                    {{ form_widget(resetForm.plainPassword.second, {attr: {id: 'password2', class: 'form-control'}}) }}
                    <button type="button" class="btn btn-outline-secondary toggle-password"
                            onclick="togglePass('password2','icon2')" tabindex="-1">
                        <i class="bi bi-eye" id="icon2"></i>
                    </button>
                </div>
                {{ form_errors(resetForm.plainPassword.second) }}
            </div>
            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                <i class="bi bi-check-circle me-2"></i>Guardar nueva contraseña
            </button>
        {{ form_end(resetForm) }}
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
function togglePass(inputId, iconId) {
    const input = document.getElementById(inputId);
    const icon  = document.getElementById(iconId);
    if (input.type === 'password') {
        input.type = 'text';
        icon.className = 'bi bi-eye-slash';
    } else {
        input.type = 'password';
        icon.className = 'bi bi-eye';
    }
}
</script>
</body>
</html>
