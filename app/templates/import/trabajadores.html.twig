{% extends 'base.html.twig' %}
{% block title %}Importar personal{% endblock %}
{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0 fw-bold">Importar personal</h4>
        <small class="text-muted">Carga masiva desde CSV</small>
    </div>
    <a href="{{ path('app_import_index') }}" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Volver
    </a>
</div>

{% if resultado is not null %}
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm text-center p-3">
                <div class="fs-2 fw-bold text-success">{{ resultado.importados }}</div>
                <small class="text-muted">Importados</small>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm text-center p-3">
                <div class="fs-2 fw-bold text-warning">{{ resultado.omitidos }}</div>
                <small class="text-muted">Omitidos (RUT ya existe)</small>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm text-center p-3">
                <div class="fs-2 fw-bold text-danger">{{ resultado.errores|length }}</div>
                <small class="text-muted">Errores</small>
            </div>
        </div>
    </div>

    {% if resultado.errores|length > 0 %}
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-danger bg-opacity-10 border-0">
            <h6 class="mb-0 fw-semibold text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Filas con error</h6>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width:80px">Línea</th>
                        <th style="width:160px">RUT</th>
                        <th>Motivo</th>
                    </tr>
                </thead>
                <tbody>
                    {% for e in resultado.errores %}
                    <tr>
                        <td class="ps-3">{{ e.linea }}</td>
                        <td><code>{{ e.rut }}</code></td>
                        <td class="text-danger small">{{ e.motivo }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% endif %}

    {% if resultado.importados > 0 %}
    <div class="alert alert-success">
        <i class="bi bi-check-circle me-2"></i>
        Se importaron <strong>{{ resultado.importados }}</strong> trabajador(es) correctamente.
        <a href="{{ path('app_trabajador_index') }}" class="alert-link ms-2">Ver personal</a>
    </div>
    {% endif %}
{% endif %}

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <h6 class="fw-semibold mb-1">Subir archivo CSV</h6>
        <p class="text-muted small mb-3">
            El archivo debe tener las columnas en el orden de la plantilla. Separador: punto y coma (;).
        </p>
        <form method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label class="form-label fw-semibold">Archivo CSV</label>
                <input type="file" name="archivo" class="form-control" accept=".csv,text/csv" required>
                <div class="form-text">Máximo 5 MB. Formato: UTF-8 o UTF-8 con BOM.</div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-upload me-2"></i>Importar personal
                </button>
                <a href="{{ path('app_import_trabajadores_plantilla') }}" class="btn btn-outline-secondary">
                    <i class="bi bi-file-earmark-arrow-down me-2"></i>Descargar plantilla
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm mt-4">
    <div class="card-body p-4">
        <h6 class="fw-semibold mb-3">Columnas del CSV</h6>
        <div class="table-responsive">
            <table class="table table-sm table-bordered mb-0 small">
                <thead class="table-light">
                    <tr><th>Columna</th><th>Obligatorio</th><th>Valores válidos</th><th>Ejemplo</th></tr>
                </thead>
                <tbody>
                    <tr><td><code>nombres</code></td><td><span class="badge bg-danger">Sí</span></td><td>Texto</td><td>María Paz</td></tr>
                    <tr><td><code>apellidos</code></td><td><span class="badge bg-danger">Sí</span></td><td>Texto</td><td>González López</td></tr>
                    <tr><td><code>rut</code></td><td><span class="badge bg-danger">Sí</span></td><td>Texto con puntos y guión</td><td>12.345.678-9</td></tr>
                    <tr><td><code>perfil</code></td><td><span class="badge bg-danger">Sí</span></td><td>TENS · CUIDADOR · ENFERMERA · OTRO</td><td>ENFERMERA</td></tr>
                    <tr><td><code>email</code></td><td><span class="badge bg-secondary">No</span></td><td>Email válido</td><td>mgonzalez@clinica.cl</td></tr>
                    <tr><td><code>telefono</code></td><td><span class="badge bg-secondary">No</span></td><td>Texto</td><td>+56 9 1234 5678</td></tr>
                    <tr><td><code>direccion</code></td><td><span class="badge bg-secondary">No</span></td><td>Texto</td><td>Av. Las Condes 456</td></tr>
                    <tr><td><code>estado</code></td><td><span class="badge bg-secondary">No</span></td><td>ACTIVO · INACTIVO · SUSPENDIDO (default: ACTIVO)</td><td>ACTIVO</td></tr>
                    <tr><td><code>fecha_ingreso</code></td><td><span class="badge bg-secondary">No</span></td><td>dd/mm/aaaa</td><td>10/01/2024</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
