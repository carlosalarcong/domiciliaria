{% extends 'base.html.twig' %}
{% block title %}Personal{% endblock %}
{% block help_modulo %}personal{% endblock %}
{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0 fw-bold">Personal</h4>
        <small class="text-muted">Trabajadores registrados</small>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('app_trabajador_exportar') }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-download me-1"></i>Exportar CSV
        </a>
        <a href="{{ path('app_trabajador_exportar_excel') }}" class="btn btn-success btn-sm">
            <i class="bi bi-file-earmark-excel me-1"></i>Exportar Excel
        </a>
        {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_trabajador_new') }}" class="btn btn-primary" id="btn-nuevo-trabajador">
            <i class="bi bi-plus-lg me-2"></i>Nuevo trabajador
        </a>
        {% endif %}
    </div>
</div>

<div class="card border-0 shadow-sm" id="tabla-personal">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Nombre</th>
                        <th>RUT</th>
                        <th>Perfil</th>
                        <th>Teléfono</th>
                        <th>Estado</th>
                        <th class="pe-4 text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                {% for trabajador in pagination %}
                <tr>
                    <td class="ps-4 fw-semibold">{{ trabajador.nombreCompleto }}</td>
                    <td class="text-muted font-monospace">{{ trabajador.rut }}</td>
                    <td>{{ trabajador.perfil.etiqueta() }}</td>
                    <td class="text-muted">{{ trabajador.telefono ?? '—' }}</td>
                    <td>
                        <span class="badge {{ trabajador.estado.badgeClass() }}">{{ trabajador.estado.etiqueta() }}</span>
                    </td>
                    <td class="pe-4 text-end">
                        <div class="btn-group btn-group-sm">
                            <a href="{{ path('app_trabajador_show', {id: trabajador.id}) }}" class="btn btn-outline-secondary" title="Ver"><i class="bi bi-eye"></i></a>
                            {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_trabajador_edit', {id: trabajador.id}) }}" class="btn btn-outline-primary" title="Editar"><i class="bi bi-pencil"></i></a>
                            {% endif %}
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="6" class="text-center text-muted py-5">
                    <i class="bi bi-person-badge fs-1 opacity-25 d-block mb-2"></i>No hay trabajadores registrados.
                </td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% if pagination.pageCount > 1 %}
    <div class="card-footer bg-white border-0 d-flex justify-content-center">{{ knp_pagination_render(pagination) }}</div>
    {% endif %}
</div>
{% endblock %}
