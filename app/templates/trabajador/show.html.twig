{% extends 'base.html.twig' %}
{% block title %}{{ trabajador.nombreCompleto }}{% endblock %}
{% block content %}
<div class="d-flex align-items-center mb-4 gap-3">
    <a href="{{ path('app_trabajador_index') }}" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div class="flex-grow-1">
        <h4 class="mb-0 fw-bold">{{ trabajador.nombreCompleto }}</h4>
        <small class="text-muted">{{ trabajador.perfil.etiqueta() }}</small>
    </div>
    {% if is_granted('ROLE_ADMIN') %}
    <div class="d-flex gap-2">
        <a href="{{ path('app_trabajador_edit', {id: trabajador.id}) }}" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil me-1"></i>Editar
        </a>
        <form method="post" action="{{ path('app_trabajador_toggle_estado', {id: trabajador.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('toggle_estado_' ~ trabajador.id) }}">
            <button type="submit" class="btn btn-outline-{{ trabajador.estado.value == 'ACTIVO' ? 'warning' : 'success' }} btn-sm"
                    onclick="return confirm('¿Confirmas el cambio de estado?')">
                <i class="bi bi-{{ trabajador.estado.value == 'ACTIVO' ? 'pause' : 'play' }}-circle me-1"></i>
                {{ trabajador.estado.value == 'ACTIVO' ? 'Desactivar' : 'Activar' }}
            </button>
        </form>
    </div>
    {% endif %}
</div>

<div class="row g-4">
    {# Columna izquierda: datos del trabajador #}
    <div class="col-lg-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-4">
                <div class="bg-primary-subtle rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width:80px;height:80px;">
                    <i class="bi bi-person-badge fs-2 text-primary"></i>
                </div>
                <h6 class="fw-bold mb-1">{{ trabajador.nombreCompleto }}</h6>
                <p class="text-muted small mb-2">{{ trabajador.perfil.etiqueta() }}</p>
                <span class="badge {{ trabajador.estado.badgeClass() }}">{{ trabajador.estado.etiqueta() }}</span>
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between small">
                    <span class="text-muted">RUT</span>
                    <span class="font-monospace">{{ trabajador.rut }}</span>
                </li>
                {% if trabajador.telefono %}
                <li class="list-group-item d-flex justify-content-between small">
                    <span class="text-muted">Teléfono</span>
                    <span>{{ trabajador.telefono }}</span>
                </li>
                {% endif %}
                {% if trabajador.email %}
                <li class="list-group-item d-flex justify-content-between small">
                    <span class="text-muted">Email</span>
                    <a href="mailto:{{ trabajador.email }}" class="text-decoration-none">{{ trabajador.email }}</a>
                </li>
                {% endif %}
                {% if trabajador.direccion %}
                <li class="list-group-item small">
                    <span class="text-muted d-block">Dirección</span>
                    <span>{{ trabajador.direccion }}</span>
                </li>
                {% endif %}
                {% if trabajador.fechaIngreso %}
                <li class="list-group-item d-flex justify-content-between small">
                    <span class="text-muted">Ingreso</span>
                    <span>{{ trabajador.fechaIngreso|date('d/m/Y') }}</span>
                </li>
                {% endif %}
                {% if trabajador.user %}
                <li class="list-group-item d-flex justify-content-between small">
                    <span class="text-muted">Usuario</span>
                    <span>{{ trabajador.user.email }}</span>
                </li>
                {% endif %}
            </ul>
            <div class="card-body pt-2">
                <a href="{{ path('app_trabajador_horas', {id: trabajador.id}) }}" class="btn btn-outline-success btn-sm w-100">
                    <i class="bi bi-download me-1"></i>Exportar horas
                </a>
            </div>
        </div>
    </div>

    {# Columna derecha: pestañas #}
    <div class="col-lg-9">
        <ul class="nav nav-tabs mb-3" id="trabajadorTabs">
            <li class="nav-item">
                <a class="nav-link {{ tab == 'turnos' ? 'active' : '' }}"
                   href="{{ path('app_trabajador_show', {id: trabajador.id, tab: 'turnos'}) }}">
                    <i class="bi bi-calendar3 me-1"></i>Turnos
                    <span class="badge bg-secondary ms-1">{{ trabajador.turnos|length }}</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link {{ tab == 'documentos' ? 'active' : '' }}"
                   href="{{ path('app_trabajador_show', {id: trabajador.id, tab: 'documentos'}) }}">
                    <i class="bi bi-file-earmark me-1"></i>Documentos
                    <span class="badge bg-secondary ms-1">{{ documentos|length }}</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link {{ tab == 'disponibilidad' ? 'active' : '' }}"
                   href="{{ path('app_trabajador_show', {id: trabajador.id, tab: 'disponibilidad'}) }}">
                    <i class="bi bi-clock me-1"></i>Disponibilidad
                </a>
            </li>
        </ul>

        {# ── HISTORIAL DE TURNOS ── #}
        {% if tab == 'turnos' %}

        {# KPIs del año #}
        <div class="row g-3 mb-3">
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm text-center py-3">
                    <div class="fs-4 fw-bold text-primary">{{ totalHorasAnio }}</div>
                    <div class="small text-muted">horas en {{ anioFiltro }}</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm text-center py-3">
                    <div class="fs-4 fw-bold text-secondary">{{ totalTurnosAnio }}</div>
                    <div class="small text-muted">turnos en {{ anioFiltro }}</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm text-center py-3">
                    <div class="fs-4 fw-bold text-success">
                        {{ resumenMensual|length > 0 ? (totalHorasAnio / resumenMensual|length)|round : 0 }}
                    </div>
                    <div class="small text-muted">horas/mes promedio</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm text-center py-3">
                    <div class="fs-4 fw-bold text-info">{{ historial|length }}</div>
                    <div class="small text-muted">turnos filtrados</div>
                </div>
            </div>
        </div>

        {# Filtros año/mes #}
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body py-2">
                <form method="get" class="d-flex flex-wrap gap-2 align-items-center">
                    <input type="hidden" name="tab" value="turnos">
                    <span class="text-muted small">Período:</span>
                    <select name="anio" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
                        {% for a in anios %}
                        <option value="{{ a }}" {{ anioFiltro == a ? 'selected' : '' }}>{{ a }}</option>
                        {% endfor %}
                    </select>
                    <select name="mes" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
                        <option value="0" {{ mesFiltro is null ? 'selected' : '' }}>Todos los meses</option>
                        {% for m, nombre in {1:'Enero',2:'Febrero',3:'Marzo',4:'Abril',5:'Mayo',6:'Junio',
                                             7:'Julio',8:'Agosto',9:'Septiembre',10:'Octubre',11:'Noviembre',12:'Diciembre'} %}
                        <option value="{{ m }}" {{ mesFiltro == m ? 'selected' : '' }}>{{ nombre }}</option>
                        {% endfor %}
                    </select>
                </form>
            </div>
        </div>

        {# Resumen mensual del año #}
        {% if resumenMensual is not empty and mesFiltro is null %}
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white border-0 py-2 fw-semibold small text-muted text-uppercase" style="letter-spacing:.05em">
                Resumen mensual {{ anioFiltro }}
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0" style="font-size:.875rem">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Mes</th>
                                <th class="text-center">Turnos</th>
                                <th class="text-center">Horas</th>
                                <th class="pe-3 text-end">Filtrar</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for fila in resumenMensual %}
                        {% set partes = fila.anio_mes|split('-') %}
                        {% set nombres = {1:'Enero',2:'Febrero',3:'Marzo',4:'Abril',5:'Mayo',6:'Junio',
                                          7:'Julio',8:'Agosto',9:'Septiembre',10:'Octubre',11:'Noviembre',12:'Diciembre'} %}
                        <tr>
                            <td class="ps-3">{{ nombres[partes[1]|number_format(0,'','')] ?? fila.anio_mes }}</td>
                            <td class="text-center">{{ fila.total_turnos }}</td>
                            <td class="text-center fw-semibold">{{ fila.total_horas }} h</td>
                            <td class="pe-3 text-end">
                                <a href="{{ path('app_trabajador_show', {id: trabajador.id, tab: 'turnos', anio: anioFiltro, mes: partes[1]}) }}"
                                   class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size:.75rem">
                                    Ver
                                </a>
                            </td>
                        </tr>
                        {% endfor %}
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td class="ps-3 fw-semibold">Total</td>
                                <td class="text-center fw-semibold">{{ totalTurnosAnio }}</td>
                                <td class="text-center fw-bold text-primary">{{ totalHorasAnio }} h</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
        {% endif %}

        {# Tabla de turnos #}
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                {% if historial is empty %}
                <div class="text-center text-muted py-5">
                    <i class="bi bi-calendar-x fs-1 opacity-25 d-block mb-2"></i>
                    Sin turnos para el período seleccionado.
                </div>
                {% else %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size:.875rem">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Fecha</th>
                                <th>Paciente</th>
                                <th>Tipo</th>
                                <th class="text-center">Horas</th>
                                <th>Estado</th>
                                <th class="pe-3 text-end">Ver</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for turno in historial %}
                        <tr>
                            <td class="ps-3 text-muted small">{{ turno.fecha|date('d/m/Y') }}</td>
                            <td>{{ turno.paciente ? turno.paciente.nombreCompleto : '—' }}</td>
                            <td class="small text-muted">{{ turno.tipoTurno.etiqueta() }}</td>
                            <td class="text-center fw-semibold">{{ turno.tipoTurno.duracionHoras() }}h</td>
                            <td><span class="badge {{ turno.estado.badgeClass() }}">{{ turno.estado.etiqueta() }}</span></td>
                            <td class="pe-3 text-end">
                                <a href="{{ path('app_turno_show', {id: turno.id}) }}" class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size:.75rem">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="px-3 py-2 border-top d-flex justify-content-between align-items-center">
                    <small class="text-muted">{{ historial|length }} turno(s)</small>
                    <small class="fw-semibold text-primary">
                        Total: {{ historial|reduce((carry, t) => carry + t.tipoTurno.duracionHoras(), 0) }} horas
                    </small>
                </div>
                {% endif %}
            </div>
        </div>

        {# ── DOCUMENTOS ── #}
        {% elseif tab == 'documentos' %}
        {% if is_granted('ROLE_COORDINADOR') %}
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 fw-semibold py-3">
                <i class="bi bi-upload me-2 text-primary"></i>Subir documento
            </div>
            <div class="card-body">
                {{ form_start(formDoc, {attr: {enctype: 'multipart/form-data', novalidate: 'novalidate'}}) }}
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">{{ form_row(formDoc.tipo) }}</div>
                    <div class="col-md-5">{{ form_row(formDoc.descripcion) }}</div>
                    <div class="col-md-4">{{ form_row(formDoc.archivo) }}</div>
                </div>
                <button type="submit" class="btn btn-primary btn-sm mt-3">
                    <i class="bi bi-upload me-1"></i>Subir
                </button>
                {{ form_end(formDoc) }}
            </div>
        </div>
        {% endif %}

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Tipo</th>
                                <th>Archivo</th>
                                <th>Descripción</th>
                                <th>Tamaño</th>
                                <th>Fecha</th>
                                <th class="pe-4 text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for doc in documentos %}
                        <tr>
                            <td class="ps-4">
                                <span class="badge {{ doc.tipo.badgeClass() }}">{{ doc.tipo.etiqueta() }}</span>
                            </td>
                            <td>
                                <i class="bi {{ doc.iconoExtension }} me-1"></i>
                                <span class="small">{{ doc.nombreOriginal }}</span>
                            </td>
                            <td class="text-muted small">{{ doc.descripcion ?? '—' }}</td>
                            <td class="text-muted small">{{ doc.tamanoFormateado }}</td>
                            <td class="text-muted small">{{ doc.creadoEn|date('d/m/Y') }}</td>
                            <td class="pe-4 text-end">
                                <div class="btn-group btn-group-sm">
                                    <a href="{{ path('app_trabajador_documento_descargar', {id: trabajador.id, docId: doc.id}) }}"
                                       class="btn btn-outline-success" title="Descargar">
                                        <i class="bi bi-download"></i>
                                    </a>
                                    {% if is_granted('ROLE_ADMIN') %}
                                    <form method="post" action="{{ path('app_trabajador_documento_eliminar', {id: trabajador.id, docId: doc.id}) }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('doc_eliminar_' ~ doc.id) }}">
                                        <button type="submit" class="btn btn-outline-danger" title="Eliminar"
                                                onclick="return confirm('¿Eliminar este documento?')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr><td colspan="6" class="text-center text-muted py-4">
                            <i class="bi bi-file-earmark fs-1 opacity-25 d-block mb-2"></i>
                            Sin documentos subidos.
                        </td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        {# ── DISPONIBILIDAD ── #}
        {% elseif tab == 'disponibilidad' %}
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 fw-semibold py-3">
                <i class="bi bi-plus-circle me-2 text-primary"></i>Registrar disponibilidad
            </div>
            <div class="card-body">
                {{ form_start(formDisp, {attr: {novalidate: 'novalidate'}}) }}
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">{{ form_row(formDisp.fecha) }}</div>
                    <div class="col-md-2">{{ form_row(formDisp.horaDesde) }}</div>
                    <div class="col-md-2">{{ form_row(formDisp.horaHasta) }}</div>
                    <div class="col-md-2 pt-4">{{ form_row(formDisp.disponible) }}</div>
                    <div class="col-md-3 pt-3">
                        <button type="submit" class="btn btn-primary btn-sm w-100">
                            <i class="bi bi-plus-lg me-1"></i>Guardar
                        </button>
                    </div>
                </div>
                {{ form_end(formDisp) }}
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Fecha</th>
                                <th>Desde</th>
                                <th>Hasta</th>
                                <th>Estado</th>
                                {% if is_granted('ROLE_COORDINADOR') %}<th class="pe-4 text-end">Eliminar</th>{% endif %}
                            </tr>
                        </thead>
                        <tbody>
                        {% for disp in disponibilidades %}
                        <tr>
                            <td class="ps-4">{{ disp.fecha|date('d/m/Y') }}</td>
                            <td class="font-monospace">{{ disp.horaDesde ? disp.horaDesde|date('H:i') : '—' }}</td>
                            <td class="font-monospace">{{ disp.horaHasta ? disp.horaHasta|date('H:i') : '—' }}</td>
                            <td>
                                {% if disp.disponible %}
                                <span class="badge bg-success">Disponible</span>
                                {% else %}
                                <span class="badge bg-danger">No disponible</span>
                                {% endif %}
                            </td>
                            {% if is_granted('ROLE_COORDINADOR') %}
                            <td class="pe-4 text-end">
                                <form method="post" action="{{ path('app_trabajador_disponibilidad_eliminar', {id: trabajador.id, dispId: disp.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('disp_eliminar_' ~ disp.id) }}">
                                    <button type="submit" class="btn btn-outline-danger btn-sm"
                                            onclick="return confirm('¿Eliminar este registro?')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                            {% endif %}
                        </tr>
                        {% else %}
                        <tr><td colspan="5" class="text-center text-muted py-4">Sin registros de disponibilidad.</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}
