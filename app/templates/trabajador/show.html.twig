{% extends 'base.html.twig' %}
{% block title %}{{ trabajador.nombreCompleto }}{% endblock %}
{% block content %}
<div class="d-flex align-items-center mb-4 gap-3">
    <a href="{{ path('app_trabajador_index') }}" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div class="flex-grow-1">
        <h4 class="mb-0 fw-bold">{{ trabajador.nombreCompleto }}</h4>
        <small class="text-muted">{{ trabajador.perfil.etiqueta() }}</small>
    </div>
    {% if is_granted('ROLE_ADMIN') %}
    <div class="d-flex gap-2">
        <a href="{{ path('app_trabajador_edit', {id: trabajador.id}) }}" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil me-1"></i>Editar
        </a>
        <form method="post" action="{{ path('app_trabajador_toggle_estado', {id: trabajador.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('toggle_estado_' ~ trabajador.id) }}">
            <button type="submit" class="btn btn-outline-{{ trabajador.estado.value == 'ACTIVO' ? 'warning' : 'success' }} btn-sm"
                    onclick="return confirm('¿Confirmas el cambio de estado?')">
                <i class="bi bi-{{ trabajador.estado.value == 'ACTIVO' ? 'pause' : 'play' }}-circle me-1"></i>
                {{ trabajador.estado.value == 'ACTIVO' ? 'Desactivar' : 'Activar' }}
            </button>
        </form>
    </div>
    {% endif %}
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-4">
                <div class="bg-primary-subtle rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width:80px;height:80px;">
                    <i class="bi bi-person-badge fs-2 text-primary"></i>
                </div>
                <h5 class="fw-bold mb-1">{{ trabajador.nombreCompleto }}</h5>
                <p class="text-muted mb-2">{{ trabajador.perfil.etiqueta() }}</p>
                <span class="badge {{ trabajador.estado.badgeClass() }}">{{ trabajador.estado.etiqueta() }}</span>
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted">RUT</span>
                    <span class="font-monospace">{{ trabajador.rut }}</span>
                </li>
                {% if trabajador.telefono %}
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted">Teléfono</span>
                    <span>{{ trabajador.telefono }}</span>
                </li>
                {% endif %}
                {% if trabajador.email %}
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted">Email</span>
                    <span>{{ trabajador.email }}</span>
                </li>
                {% endif %}
                {% if trabajador.direccion %}
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted">Dirección</span>
                    <span>{{ trabajador.direccion }}</span>
                </li>
                {% endif %}
                {% if trabajador.fechaIngreso %}
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted">Ingreso</span>
                    <span>{{ trabajador.fechaIngreso|date('d/m/Y') }}</span>
                </li>
                {% endif %}
                {% if trabajador.user %}
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted">Usuario</span>
                    <span>{{ trabajador.user.email }}</span>
                </li>
                {% endif %}
            </ul>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 fw-semibold py-3">
                <i class="bi bi-calendar3 me-2 text-primary"></i>Últimos turnos
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Fecha</th>
                                <th>Paciente</th>
                                <th>Tipo</th>
                                <th>Estado</th>
                                <th class="pe-4 text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% set turnos = trabajador.turnos|slice(0, 10) %}
                        {% for turno in turnos %}
                        <tr>
                            <td class="ps-4">{{ turno.fecha|date('d/m/Y') }}</td>
                            <td>{{ turno.paciente.nombreCompleto }}</td>
                            <td>{{ turno.tipoTurno.etiqueta() }}</td>
                            <td><span class="badge {{ turno.estado.badgeClass() }}">{{ turno.estado.etiqueta() }}</span></td>
                            <td class="pe-4 text-end">
                                <a href="{{ path('app_turno_show', {id: turno.id}) }}" class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                        {% else %}
                        <tr><td colspan="5" class="text-center text-muted py-4">Sin turnos registrados.</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
