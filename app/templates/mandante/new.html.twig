{% extends 'base.html.twig' %}
{% block title %}Nuevo Mandante{% endblock %}
{% block content %}
<div class="mb-4">
    <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="{{ path('app_mandante_index') }}">Mandantes</a></li><li class="breadcrumb-item active">Nuevo</li></ol></nav>
    <h4 class="mb-0 fw-bold">Crear mandante</h4>
</div>
<div class="row"><div class="col-lg-6">
<div class="card border-0 shadow-sm"><div class="card-body p-4">
{{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
<div class="row g-3">
    <div class="col-12"><label class="form-label fw-semibold">Nombre</label>{{ form_widget(form.nombre) }}{{ form_errors(form.nombre) }}</div>
    <div class="col-md-6"><label class="form-label fw-semibold">RUT</label>{{ form_widget(form.rut) }}{{ form_errors(form.rut) }}</div>
    <div class="col-md-6"><label class="form-label fw-semibold">Teléfono</label>{{ form_widget(form.telefono) }}{{ form_errors(form.telefono) }}</div>
    <div class="col-12"><label class="form-label fw-semibold">Contacto</label>{{ form_widget(form.contacto) }}{{ form_errors(form.contacto) }}</div>
    <div class="col-12"><label class="form-label fw-semibold">Email</label>{{ form_widget(form.email) }}{{ form_errors(form.email) }}</div>
    <div class="col-12"><div class="form-check">{{ form_widget(form.activo) }}<label class="form-check-label fw-semibold" for="{{ form.activo.vars.id }}">Activo</label></div></div>
</div>
<div class="d-flex gap-2 mt-4">
    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-2"></i>Crear mandante</button>
    <a href="{{ path('app_mandante_index') }}" class="btn btn-outline-secondary">Cancelar</a>
</div>
{{ form_end(form) }}
</div></div>
</div></div>
{% endblock %}
