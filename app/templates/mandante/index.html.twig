{% extends 'base.html.twig' %}
{% block title %}Mandantes{% endblock %}
{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0 fw-bold">Mandantes</h4>
        <small class="text-muted">Empresas y entidades contratantes</small>
    </div>
    {% if is_granted('ROLE_ADMIN') %}
    <a href="{{ path('app_mandante_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-lg me-2"></i>Nuevo mandante
    </a>
    {% endif %}
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Nombre</th>
                        <th>RUT</th>
                        <th>Contacto</th>
                        <th>Email</th>
                        <th>Pacientes</th>
                        <th>Estado</th>
                        <th class="pe-4 text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                {% for mandante in mandantes %}
                <tr>
                    <td class="ps-4 fw-semibold">{{ mandante.nombre }}</td>
                    <td class="text-muted font-monospace">{{ mandante.rut }}</td>
                    <td>{{ mandante.contacto ?? '—' }}</td>
                    <td class="text-muted">{{ mandante.email ?? '—' }}</td>
                    <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle">{{ mandante.pacientes|length }}</span></td>
                    <td>
                        {% if mandante.activo %}
                            <span class="badge bg-success-subtle text-success border border-success-subtle">Activo</span>
                        {% else %}
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Inactivo</span>
                        {% endif %}
                    </td>
                    <td class="pe-4 text-end">
                        <div class="btn-group btn-group-sm">
                            <a href="{{ path('app_mandante_show', {id: mandante.id}) }}" class="btn btn-outline-secondary" title="Ver"><i class="bi bi-eye"></i></a>
                            {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_mandante_edit', {id: mandante.id}) }}" class="btn btn-outline-primary" title="Editar"><i class="bi bi-pencil"></i></a>
                            <form method="post" action="{{ path('app_mandante_toggle_activo', {id: mandante.id}) }}" class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('toggle-' ~ mandante.id) }}">
                                <button type="submit" class="btn btn-outline-{{ mandante.activo ? 'warning' : 'success' }}" onclick="return confirm('¿Confirmas?')" title="{{ mandante.activo ? 'Desactivar' : 'Activar' }}">
                                    <i class="bi bi-{{ mandante.activo ? 'pause' : 'play' }}-circle"></i>
                                </button>
                            </form>
                            {% endif %}
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="7" class="text-center text-muted py-5"><i class="bi bi-building fs-1 opacity-25 d-block mb-2"></i>No hay mandantes registrados.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% if mandantes.pageCount > 1 %}
    <div class="card-footer bg-white border-0 d-flex justify-content-center">{{ knp_pagination_render(mandantes) }}</div>
    {% endif %}
</div>
{% endblock %}
