{% extends 'base.html.twig' %}
{% block title %}Calendario de Turnos{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0 fw-bold">Calendario de Turnos</h4>
        <small class="text-muted">Vista de turnos por fecha</small>
    </div>
    {% if is_granted('ROLE_COORDINADOR') %}
    <a href="{{ path('app_turno_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-lg me-2"></i>Nuevo turno
    </a>
    {% endif %}
</div>

{# Leyenda #}
<div class="d-flex gap-3 mb-3 flex-wrap">
    <span class="badge py-2 px-3" style="background:#198754">Cubierto</span>
    <span class="badge py-2 px-3" style="background:#ffc107;color:#000">Parcial</span>
    <span class="badge py-2 px-3" style="background:#dc3545">Descubierto</span>
    <span class="badge py-2 px-3" style="background:#0d6efd">Completado</span>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div id="calendar"></div>
    </div>
</div>

{# Modal detalle de turno #}
<div class="modal fade" id="turnoModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Detalle del turno</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="turnoModalBody">
                <div class="text-center py-3"><div class="spinner-border text-primary"></div></div>
            </div>
            <div class="modal-footer border-0" id="turnoModalFooter"></div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
{# FullCalendar vía CDN #}
<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const calendarEl = document.getElementById('calendar');
    const modal      = new bootstrap.Modal(document.getElementById('turnoModal'));
    const modalBody  = document.getElementById('turnoModalBody');
    const modalFooter = document.getElementById('turnoModalFooter');

    const isMobile = () => window.innerWidth < 768;

    const toolbarDesktop = {
        left:   'prev,next today',
        center: 'title',
        right:  'dayGridMonth,timeGridWeek,listWeek',
    };
    const toolbarMobile = {
        left:   'prev,next',
        center: 'title',
        right:  'today listWeek',
    };

    const calendar = new FullCalendar.Calendar(calendarEl, {
        locale: 'es',
        initialView: isMobile() ? 'listWeek' : 'dayGridMonth',
        headerToolbar: isMobile() ? toolbarMobile : toolbarDesktop,
        buttonText: {
            today:   'Hoy',
            month:   'Mes',
            week:    'Semana',
            day:     'Día',
            list:    'Lista',
        },
        windowResize: function () {
            calendar.changeView(isMobile() ? 'listWeek' : 'dayGridMonth');
            calendar.setOption('headerToolbar', isMobile() ? toolbarMobile : toolbarDesktop);
        },
        events: {
            url:    '{{ path('app_turno_api_eventos') }}',
            method: 'GET',
            failure: function () {
                alert('Error al cargar los turnos.');
            },
        },
        eventClick: function (info) {
            const turnoId = info.event.id;
            modalBody.innerHTML = '<div class="text-center py-3"><div class="spinner-border text-primary"></div></div>';
            modalFooter.innerHTML = '';
            modal.show();

            fetch(`/turnos/${turnoId}/detalle`)
                .then(r => r.text())
                .then(html => {
                    modalBody.innerHTML = html;
                    modalFooter.innerHTML = `<a href="/turnos/${turnoId}" class="btn btn-primary btn-sm">Ver detalle completo</a>`;
                });
        },
        eventDidMount: function (info) {
            info.el.title = info.event.title;
        },
    });

    calendar.render();
});
</script>
{% endblock %}
