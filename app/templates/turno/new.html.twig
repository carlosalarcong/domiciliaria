{% extends 'base.html.twig' %}
{% block title %}Nuevo turno{% endblock %}
{% block content %}
<div class="d-flex align-items-center mb-4 gap-3">
    <a href="{{ path('app_turno_index') }}" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div>
        <h4 class="mb-0 fw-bold">Nuevo turno</h4>
        <small class="text-muted">Programar un nuevo turno de atención</small>
    </div>
</div>

<div class="card border-0 shadow-sm" style="max-width:750px;">
    <div class="card-body p-4" data-controller="disponibilidad" data-disponibilidad-url-value="{{ path('app_turno_api_disponibilidad') }}">
        {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}

        <div class="row g-3">
            <div class="col-12">{{ form_row(form.paciente) }}</div>
            <div class="col-md-6">
                {{ form_label(form.fecha) }}
                {{ form_widget(form.fecha, {attr: {'data-disponibilidad-target': 'fecha', 'data-action': 'change->disponibilidad#verificar'}}) }}
                {{ form_errors(form.fecha) }}
            </div>
            <div class="col-md-3">
                {{ form_label(form.horaInicio) }}
                {{ form_widget(form.horaInicio, {attr: {'data-disponibilidad-target': 'inicio', 'data-action': 'change->disponibilidad#verificar'}}) }}
                {{ form_errors(form.horaInicio) }}
            </div>
            <div class="col-md-3">
                {{ form_label(form.horaTermino) }}
                {{ form_widget(form.horaTermino, {attr: {'data-disponibilidad-target': 'termino', 'data-action': 'change->disponibilidad#verificar'}}) }}
                {{ form_errors(form.horaTermino) }}
            </div>
            <div class="col-md-6">{{ form_row(form.tipoTurno) }}</div>
            <div class="col-md-6">
                {{ form_label(form.trabajador) }}
                {{ form_widget(form.trabajador, {attr: {'data-disponibilidad-target': 'trabajador', 'data-action': 'change->disponibilidad#verificar'}}) }}
                {{ form_errors(form.trabajador) }}
                <div id="avail-alert" class="mt-1" data-disponibilidad-target="alerta"></div>
            </div>
            <div class="col-12">{{ form_row(form.observaciones) }}</div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-2"></i>Crear turno</button>
            <a href="{{ path('app_turno_index') }}" class="btn btn-light">Cancelar</a>
        </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
