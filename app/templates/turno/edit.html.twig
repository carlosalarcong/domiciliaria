{% extends 'base.html.twig' %}
{% block title %}Editar turno{% endblock %}
{% block content %}
<div class="d-flex align-items-center mb-4 gap-3">
    <a href="{{ path('app_turno_show', {id: turno.id}) }}" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div>
        <h4 class="mb-0 fw-bold">Editar turno</h4>
        <small class="text-muted">{{ turno.paciente.nombreCompleto }} — {{ turno.fecha|date('d/m/Y') }}</small>
    </div>
</div>

<div class="card border-0 shadow-sm" style="max-width:750px;">
    <div class="card-body p-4">
        {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
        <div class="row g-3">
            <div class="col-12">{{ form_row(form.paciente) }}</div>
            <div class="col-md-6">{{ form_row(form.fecha) }}</div>
            <div class="col-md-3">{{ form_row(form.horaInicio) }}</div>
            <div class="col-md-3">{{ form_row(form.horaTermino) }}</div>
            <div class="col-md-6">{{ form_row(form.tipoTurno) }}</div>
            <div class="col-md-6">{{ form_row(form.trabajador) }}</div>
            <div class="col-12">{{ form_row(form.observaciones) }}</div>
        </div>
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-2"></i>Guardar cambios</button>
            <a href="{{ path('app_turno_show', {id: turno.id}) }}" class="btn btn-light">Cancelar</a>
        </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
