{% extends 'base.html.twig' %}
{% block title %}Nueva factura{% endblock %}
{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0 fw-bold">Nueva factura</h4>
        <small class="text-muted">Generar factura para un mandante</small>
    </div>
    <a href="{{ path('app_finanzas_facturas') }}" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Volver
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        {{ form_start(form) }}

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                {{ form_row(form.mandante) }}
            </div>
            <div class="col-md-3">
                {{ form_row(form.anio) }}
            </div>
            <div class="col-md-3">
                {{ form_row(form.mes) }}
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                {{ form_row(form.montoNeto) }}
            </div>
            <div class="col-md-2">
                {{ form_row(form.porcentajeIva) }}
            </div>
            <div class="col-md-3">
                {{ form_row(form.numeroFactura) }}
            </div>
        </div>

        <div class="mb-4">
            {{ form_row(form.observaciones) }}
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success">
                <i class="bi bi-file-earmark-plus me-2"></i>Crear factura
            </button>
            <a href="{{ path('app_finanzas_facturas') }}" class="btn btn-outline-secondary">Cancelar</a>
        </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
