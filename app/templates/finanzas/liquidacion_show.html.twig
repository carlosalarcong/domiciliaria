{% extends 'base.html.twig' %}
{% block title %}Liquidación — {{ liquidacion.trabajador.nombreCompleto }}{% endblock %}
{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0 fw-bold">Liquidación — {{ liquidacion.trabajador.nombreCompleto }}</h4>
        <small class="text-muted">{{ liquidacion.periodoLabel }}</small>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('app_finanzas_liquidacion_exportar', {id: liquidacion.id}) }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-download me-1"></i>Exportar CSV
        </a>
        <a href="{{ path('app_finanzas_liquidaciones') }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
    </div>
</div>

{# Resumen #}
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="fw-bold fs-4">{{ liquidacion.totalTurnos }}</div>
            <div class="small text-muted">Turnos</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="fw-bold fs-4">{{ liquidacion.totalHoras }} h</div>
            <div class="small text-muted">Horas</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="fw-bold fs-4">$ {{ liquidacion.montoTotal|number_format(0, ',', '.') }}</div>
            <div class="small text-muted">Monto total</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center p-3">
            <span class="badge {{ liquidacion.estado.badgeClass() }} fs-6">{{ liquidacion.estado.etiqueta() }}</span>
            <div class="small text-muted mt-1">Estado</div>
        </div>
    </div>
</div>

{# Detalle de ítems #}
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-0 fw-semibold py-3">
        <i class="bi bi-list-ul me-2 text-primary"></i>Detalle de conceptos
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Concepto</th>
                        <th>Descripción</th>
                        <th class="text-end">Cantidad</th>
                        <th class="text-end">Valor unitario</th>
                        <th class="text-end pe-4">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                {% for item in liquidacion.items %}
                <tr>
                    <td class="ps-4">
                        <span class="badge bg-secondary">{{ item.concepto.etiqueta() }}</span>
                    </td>
                    <td class="text-muted small">{{ item.descripcion }}</td>
                    <td class="text-end">{{ item.cantidad }}</td>
                    <td class="text-end">$ {{ item.valorUnitario|number_format(0, ',', '.') }}</td>
                    <td class="text-end fw-semibold pe-4">$ {{ item.subtotal|number_format(0, ',', '.') }}</td>
                </tr>
                {% else %}
                <tr><td colspan="5" class="text-center text-muted py-4">Sin ítems registrados.</td></tr>
                {% endfor %}
                </tbody>
                {% if liquidacion.items|length > 0 %}
                <tfoot class="table-light">
                    <tr>
                        <td colspan="4" class="text-end fw-bold pe-2 py-3">Total</td>
                        <td class="text-end fw-bold pe-4 py-3">$ {{ liquidacion.montoTotal|number_format(0, ',', '.') }}</td>
                    </tr>
                </tfoot>
                {% endif %}
            </table>
        </div>
    </div>
</div>

{# Acciones #}
{% if is_granted('FINANZAS_EDITAR') %}
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-0 fw-semibold py-3">
        <i class="bi bi-gear me-2 text-secondary"></i>Acciones
    </div>
    <div class="card-body d-flex gap-3 flex-wrap">

        {% if liquidacion.estado.value == 'borrador' %}
        <form method="post" action="{{ path('app_finanzas_liquidacion_aprobar', {id: liquidacion.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('liq_' ~ liquidacion.id) }}">
            <button type="submit" class="btn btn-success"
                    onclick="return confirm('¿Aprobar esta liquidación?')">
                <i class="bi bi-check-circle me-2"></i>Aprobar
            </button>
        </form>
        {% endif %}

        {% if liquidacion.estado.value == 'aprobada' %}
        <form method="post" action="{{ path('app_finanzas_liquidacion_pagar', {id: liquidacion.id}) }}" class="d-flex gap-2 align-items-center">
            <input type="hidden" name="_token" value="{{ csrf_token('liq_' ~ liquidacion.id) }}">
            <input type="date" name="fecha_pago" class="form-control form-control-sm" value="{{ 'today'|date('Y-m-d') }}" required style="width:160px">
            <button type="submit" class="btn btn-primary"
                    onclick="return confirm('¿Marcar como pagada?')">
                <i class="bi bi-cash me-2"></i>Marcar pagada
            </button>
        </form>
        {% endif %}

    </div>
</div>
{% endif %}

{% if liquidacion.fechaPago %}
<div class="alert alert-success mt-3">
    <i class="bi bi-check-circle me-2"></i>
    Pagada el <strong>{{ liquidacion.fechaPago|date('d/m/Y') }}</strong>
</div>
{% endif %}
{% endblock %}
