{% extends 'base.html.twig' %}
{% block title %}Facturas{% endblock %}
{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0 fw-bold">Facturación a mandantes</h4>
        <small class="text-muted">Resumen mensual por mandante</small>
    </div>
    {% if is_granted('FINANZAS_EDITAR') %}
    <a href="{{ path('app_finanzas_factura_nueva') }}" class="btn btn-success">
        <i class="bi bi-plus-lg me-2"></i>Nueva factura
    </a>
    {% endif %}
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-auto">
                <input type="number" name="anio" class="form-control form-control-sm" value="{{ anio }}" min="2020" max="2099" style="width:90px">
            </div>
            <div class="col-auto">
                <select name="estado" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">Todos los estados</option>
                    {% for e in estados %}
                    <option value="{{ e.value }}" {{ filtroEstado == e.value ? 'selected' : '' }}>{{ e.etiqueta() }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-secondary btn-sm">Filtrar</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Mandante</th>
                        <th>N° Factura</th>
                        <th>Período</th>
                        <th class="text-end">Neto</th>
                        <th class="text-end">IVA</th>
                        <th class="text-end">Total</th>
                        <th>Estado</th>
                        <th>Vencimiento</th>
                        <th class="pe-4 text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                {% for fac in pagination %}
                <tr>
                    <td class="ps-4 fw-semibold">{{ fac.mandante.nombre }}</td>
                    <td class="text-muted small">{{ fac.numeroFactura ?? '—' }}</td>
                    <td>{{ fac.periodoLabel }}</td>
                    <td class="text-end">$ {{ fac.montoNeto|number_format(0, ',', '.') }}</td>
                    <td class="text-end text-muted small">$ {{ fac.montoIva|number_format(0, ',', '.') }}</td>
                    <td class="text-end fw-semibold">$ {{ fac.montoTotal|number_format(0, ',', '.') }}</td>
                    <td><span class="badge {{ fac.estado.badgeClass() }}">{{ fac.estado.etiqueta() }}</span></td>
                    <td>
                        {% if fac.fechaVencimiento %}
                            <span class="{{ fac.estado.value == 'vencida' ? 'text-danger fw-semibold' : 'text-muted' }}">
                                {{ fac.fechaVencimiento|date('d/m/Y') }}
                            </span>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td class="pe-4 text-end">
                        <a href="{{ path('app_finanzas_factura_show', {id: fac.id}) }}" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-eye"></i>
                        </a>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="9" class="text-center text-muted py-5">No hay facturas para el período.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% if pagination.pageCount > 1 %}
    <div class="card-footer bg-white border-0 d-flex justify-content-center">{{ knp_pagination_render(pagination) }}</div>
    {% endif %}
</div>
{% endblock %}
