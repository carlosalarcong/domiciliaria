{% extends 'base.html.twig' %}
{% block title %}Liquidaciones{% endblock %}
{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0 fw-bold">Liquidaciones de personal</h4>
        <small class="text-muted">Resumen mensual por trabajador</small>
    </div>
    <div class="d-flex gap-2">
        {% if is_granted('FINANZAS_EDITAR') %}
        <a href="{{ path('app_finanzas_liquidaciones_exportar_buk', {
                anio: anio,
                mes: app.request.query.getInt('mes', 0) ?: 'now'|date('n')
            }) }}"
           class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-download me-1"></i>Exportar Buk
        </a>
        <a href="{{ path('app_finanzas_liquidacion_nueva') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg me-2"></i>Nueva liquidación
        </a>
        {% endif %}
    </div>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-auto">
                <input type="number" name="anio" class="form-control form-control-sm" value="{{ anio }}" min="2020" max="2099" style="width:90px">
            </div>
            <div class="col-auto">
                <select name="estado" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">Todos los estados</option>
                    {% for e in estados %}
                    <option value="{{ e.value }}" {{ filtroEstado == e.value ? 'selected' : '' }}>{{ e.etiqueta() }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-secondary btn-sm">Filtrar</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Trabajador</th>
                        <th>Período</th>
                        <th>Turnos</th>
                        <th>Horas</th>
                        <th class="text-end">Monto total</th>
                        <th>Estado</th>
                        <th class="pe-4 text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                {% for liq in pagination %}
                <tr>
                    <td class="ps-4 fw-semibold">{{ liq.trabajador.nombreCompleto }}</td>
                    <td>{{ liq.periodoLabel }}</td>
                    <td>{{ liq.totalTurnos }}</td>
                    <td>{{ liq.totalHoras }} h</td>
                    <td class="text-end fw-semibold">$ {{ liq.montoTotal|number_format(0, ',', '.') }}</td>
                    <td><span class="badge {{ liq.estado.badgeClass() }}">{{ liq.estado.etiqueta() }}</span></td>
                    <td class="pe-4 text-end">
                        <a href="{{ path('app_finanzas_liquidacion_show', {id: liq.id}) }}" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-eye"></i>
                        </a>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="7" class="text-center text-muted py-5">No hay liquidaciones para el período.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% if pagination.pageCount > 1 %}
    <div class="card-footer bg-white border-0 d-flex justify-content-center">{{ knp_pagination_render(pagination) }}</div>
    {% endif %}
</div>
{% endblock %}
