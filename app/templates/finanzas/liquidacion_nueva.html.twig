{% extends 'base.html.twig' %}
{% block title %}Nueva liquidación{% endblock %}
{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0 fw-bold">Nueva liquidación</h4>
        <small class="text-muted">Las tarifas se aplican automáticamente desde la configuración</small>
    </div>
    <a href="{{ path('app_finanzas_liquidaciones') }}" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Volver
    </a>
</div>

<div class="card border-0 shadow-sm" style="max-width: 640px;">
    <div class="card-body p-4">
        <div class="alert alert-info d-flex align-items-center mb-4 py-2">
            <i class="bi bi-info-circle-fill me-2"></i>
            <small>
                Los valores se calculan usando las <a href="{{ path('app_tarifa_index') }}" class="alert-link">tarifas configuradas</a>.
                Si no existe tarifa vigente para algún concepto, se mostrará un error.
            </small>
        </div>

        {{ form_start(form, {attr: {class: 'needs-validation'}}) }}
        <div class="row g-3">
            <div class="col-12">{{ form_row(form.trabajador) }}</div>
            <div class="col-md-6">{{ form_row(form.anio) }}</div>
            <div class="col-md-6">{{ form_row(form.mes) }}</div>
            <div class="col-12">{{ form_row(form.observaciones) }}</div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-calculator me-2"></i>Generar liquidación
            </button>
            <a href="{{ path('app_finanzas_liquidaciones') }}" class="btn btn-outline-secondary">Cancelar</a>
        </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
