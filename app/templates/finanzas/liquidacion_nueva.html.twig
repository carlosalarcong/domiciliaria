{% extends 'base.html.twig' %}
{% block title %}Nueva liquidación{% endblock %}
{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0 fw-bold">Nueva liquidación</h4>
        <small class="text-muted">Generar liquidación mensual de personal</small>
    </div>
    <a href="{{ path('app_finanzas_liquidaciones') }}" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Volver
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        {{ form_start(form, {attr: {class: 'needs-validation'}}) }}

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                {{ form_row(form.trabajador) }}
            </div>
            <div class="col-md-3">
                {{ form_row(form.anio) }}
            </div>
            <div class="col-md-3">
                {{ form_row(form.mes) }}
            </div>
        </div>

        <h6 class="fw-semibold text-muted border-bottom pb-2 mb-3">Tarifas por tipo de concepto ($ por hora)</h6>
        <div class="row g-3 mb-4">
            {% for field in form %}
                {% if field.vars.name starts with 'tarifa_' %}
                <div class="col-md-4">
                    {{ form_row(field) }}
                </div>
                {% endif %}
            {% endfor %}
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-calculator me-2"></i>Generar liquidación
            </button>
            <a href="{{ path('app_finanzas_liquidaciones') }}" class="btn btn-outline-secondary">Cancelar</a>
        </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
