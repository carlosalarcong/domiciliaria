{% extends 'base.html.twig' %}
{% block title %}Editar — {{ suscripcion.nombre }}{% endblock %}
{% block page_title %}Editar integración{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0 fw-bold">{{ suscripcion.nombre }}</h4>
        <small class="text-muted">Editar configuración</small>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('app_integracion_show', {id: suscripcion.id}) }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
        <form method="post" action="{{ path('app_integracion_eliminar', {id: suscripcion.id}) }}"
              onsubmit="return confirm('¿Eliminar esta integración y todo su historial?')">
            <input type="hidden" name="_token" value="{{ csrf_token('wh_' ~ suscripcion.id) }}">
            <button type="submit" class="btn btn-outline-danger btn-sm">
                <i class="bi bi-trash me-1"></i>Eliminar
            </button>
        </form>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4" data-controller="webhook">
                {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}

                <div class="mb-3">
                    {{ form_label(form.nombre, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.nombre, {attr: {class: 'form-control'}}) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.url, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.url, {attr: {class: 'form-control font-monospace'}}) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.secret, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                    <div class="input-group">
                        <input type="text" class="form-control font-monospace" id="secretDisplay" data-webhook-target="secret"
                               value="{{ suscripcion.secret }}" readonly>
                        <button type="button" class="btn btn-outline-secondary" data-action="click->webhook#copiar">
                            <i class="bi bi-clipboard"></i>
                        </button>
                    </div>
                    <div class="form-text">Para cambiar la clave, escribe una nueva en el campo de abajo.</div>
                    {{ form_widget(form.secret, {attr: {class: 'form-control font-monospace mt-1', placeholder: 'Nueva clave (dejar vacío para mantener la actual)'}}) }}
                </div>

                <div class="mb-4">
                    {{ form_label(form.eventos, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                    <div class="card bg-light border-0 p-3">
                        {% set grupos = {} %}
                        {% for child in form.eventos %}
                            {% set grupo = child.vars.attr['data-group'] ?? 'Otros' %}
                            {% set grupos = grupos|merge({(grupo): (grupos[grupo] ?? [])|merge([child])}) %}
                        {% endfor %}
                        {% for grupo, items in grupos %}
                        <div class="mb-3">
                            <div class="text-muted small fw-bold text-uppercase mb-2" style="letter-spacing:.05em">{{ grupo }}</div>
                            {% for child in items %}
                            <div class="form-check">
                                {{ form_widget(child, {attr: {class: 'form-check-input'}}) }}
                                {{ form_label(child, null, {label_attr: {class: 'form-check-label'}}) }}
                            </div>
                            {% endfor %}
                        </div>
                        {% endfor %}
                    </div>
                </div>

                <div class="mb-4 form-check form-switch">
                    {{ form_widget(form.activo, {attr: {class: 'form-check-input', role: 'switch'}}) }}
                    {{ form_label(form.activo, null, {label_attr: {class: 'form-check-label fw-semibold'}}) }}
                </div>

                {# Test ping #}
                <div class="border rounded p-3 mb-4 bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-semibold small">Test de conexión</div>
                            <div class="text-muted small">Envía un ping al endpoint para verificar que responde.</div>
                        </div>
                        <form id="pingForm" method="post" action="{{ path('app_integracion_ping', {id: suscripcion.id}) }}" data-webhook-target="pingForm">
                            <input type="hidden" name="_token" value="{{ csrf_token('wh_ping_' ~ suscripcion.id) }}">
                            <button type="button" class="btn btn-outline-primary btn-sm" data-action="click->webhook#ping">
                                <i class="bi bi-send me-1"></i>Ping
                            </button>
                        </form>
                    </div>
                    <div id="pingResult" class="mt-2 small d-none" data-webhook-target="pingResult"></div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-2"></i>Guardar cambios
                    </button>
                    <a href="{{ path('app_integracion_show', {id: suscripcion.id}) }}" class="btn btn-outline-secondary">Cancelar</a>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
