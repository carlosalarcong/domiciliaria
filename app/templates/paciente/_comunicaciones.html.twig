<turbo-frame id="comunicaciones-frame">
<div class="row g-4">
    <div class="col-md-4">
        <div class="card border-0 bg-light">
            <div class="card-body">
                <h6 class="fw-semibold mb-3"><i class="bi bi-plus-circle me-2 text-primary"></i>Registrar comunicación</h6>
                {{ form_start(comunicacionForm) }}
                <div class="mb-2">
                    <label class="form-label fw-semibold small">Tipo</label>
                    {{ form_widget(comunicacionForm.tipo) }}
                </div>
                <div class="mb-2">
                    <label class="form-label fw-semibold small">Persona contactada</label>
                    {{ form_widget(comunicacionForm.contacto) }}
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Descripción</label>
                    {{ form_widget(comunicacionForm.descripcion) }}
                </div>
                <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-chat-plus me-2"></i>Registrar</button>
                {{ form_end(comunicacionForm) }}
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <h6 class="fw-semibold mb-3 text-muted">Historial de comunicaciones</h6>
        {% if paciente.comunicaciones is empty %}
            <div class="text-center text-muted py-4"><i class="bi bi-chat-dots fs-1 opacity-25 d-block mb-2"></i>Sin comunicaciones registradas.</div>
        {% else %}
            {% for com in paciente.comunicaciones %}
            <div class="d-flex gap-3 mb-3">
                <div class="flex-shrink-0">
                    <span class="badge {{ com.tipo.badgeClass }} rounded-pill px-2 py-1" style="font-size:.7rem">{{ com.tipo.etiqueta }}</span>
                </div>
                <div class="flex-grow-1 border-bottom pb-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            {% if com.contacto %}<div class="fw-semibold small">{{ com.contacto }}</div>{% endif %}
                            <p class="mb-1 mt-1">{{ com.descripcion }}</p>
                        </div>
                        <small class="text-muted text-nowrap ms-2">{{ com.creadoEn ? com.creadoEn|date('d/m/Y H:i') : '' }}</small>
                    </div>
                    <small class="text-muted"><i class="bi bi-person me-1"></i>{{ com.creadoPor ? com.creadoPor.nombreCompleto : 'Sistema' }}</small>
                </div>
            </div>
            {% endfor %}
        {% endif %}
    </div>
</div>
</turbo-frame>
