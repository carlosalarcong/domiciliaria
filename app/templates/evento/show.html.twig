{% extends 'base.html.twig' %}
{% block title %}Evento adverso — {{ evento.paciente.nombreCompleto }}{% endblock %}
{% block content %}
<div class="d-flex align-items-center mb-4 gap-3">
    <a href="{{ path('app_evento_index') }}" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div class="flex-grow-1">
        <h4 class="mb-0 fw-bold">
            <i class="bi {{ evento.tipo.icono() }} me-2"></i>{{ evento.tipo.etiqueta() }}
        </h4>
        <small class="text-muted">{{ evento.paciente.nombreCompleto }} — {{ evento.fechaEvento|date('d/m/Y') }}</small>
    </div>
    <div class="d-flex gap-2">
        {% if evento.estado.value != 'CERRADO' %}
        <a href="{{ path('app_evento_edit', {id: evento.id}) }}" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil me-1"></i>Editar
        </a>
        {% endif %}
        <span class="badge {{ evento.gravedad.badgeClass() }} py-2 px-3 fs-6">{{ evento.gravedad.etiqueta() }}</span>
        <span class="badge {{ evento.estado.badgeClass() }} py-2 px-3 fs-6">{{ evento.estado.etiqueta() }}</span>
    </div>
</div>

<div class="row g-4">
    {# Datos del evento #}
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 fw-semibold py-3">
                <i class="bi bi-info-circle me-2 text-danger"></i>Datos del evento
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted">Paciente</span>
                    <a href="{{ path('app_paciente_show', {id: evento.paciente.id}) }}" class="fw-semibold text-decoration-none">
                        {{ evento.paciente.nombreCompleto }}
                    </a>
                </li>
                {% if evento.trabajador %}
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted">Trabajador involucrado</span>
                    <a href="{{ path('app_trabajador_show', {id: evento.trabajador.id}) }}" class="text-decoration-none">
                        {{ evento.trabajador.nombreCompleto }}
                    </a>
                </li>
                {% endif %}
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span class="text-muted">Responsable</span>
                    {% if evento.responsable %}
                        <span class="fw-semibold">
                            <i class="bi bi-person-check-fill text-primary me-1"></i>
                            {{ evento.responsable.nombreCompleto }}
                            <span class="badge bg-secondary ms-1" style="font-size:.7rem">{{ evento.responsable.rolEtiqueta }}</span>
                        </span>
                    {% else %}
                        <span class="text-danger fst-italic small"><i class="bi bi-person-x me-1"></i>Sin responsable</span>
                    {% endif %}
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted">Fecha</span>
                    <span>{{ evento.fechaEvento|date('d/m/Y') }}
                        {% if evento.horaEvento %} {{ evento.horaEvento|date('H:i') }}{% endif %}
                    </span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted">Tipo</span>
                    <span><i class="bi {{ evento.tipo.icono() }} me-1"></i>{{ evento.tipo.etiqueta() }}</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted">Gravedad</span>
                    <span class="badge {{ evento.gravedad.badgeClass() }}">{{ evento.gravedad.etiqueta() }}</span>
                </li>
                <li class="list-group-item">
                    <span class="text-muted d-block small mb-1">Descripción</span>
                    <p class="mb-0">{{ evento.descripcion }}</p>
                </li>
                {% if evento.accionesTomadas %}
                <li class="list-group-item">
                    <span class="text-muted d-block small mb-1">Acciones tomadas</span>
                    <p class="mb-0">{{ evento.accionesTomadas }}</p>
                </li>
                {% endif %}
                <li class="list-group-item d-flex gap-3">
                    <span class="{{ evento.notificadoFamilia ? 'text-success' : 'text-muted' }}">
                        <i class="bi bi-{{ evento.notificadoFamilia ? 'check-circle-fill' : 'circle' }} me-1"></i>Familia
                    </span>
                    <span class="{{ evento.notificadoMedico ? 'text-success' : 'text-muted' }}">
                        <i class="bi bi-{{ evento.notificadoMedico ? 'check-circle-fill' : 'circle' }} me-1"></i>Médico
                    </span>
                </li>
            </ul>
        </div>

        {# ── Flujo de estado ── #}

        {# PASO 1: Registrado → poner en revisión #}
        {% if evento.estado.puedePonerEnRevision() %}
        <div class="card border-0 shadow-sm border-start border-warning border-4">
            <div class="card-body">
                <h6 class="fw-semibold text-warning mb-1"><i class="bi bi-search me-2"></i>Poner en revisión</h6>
                <p class="text-muted small mb-3">Asigna el evento al flujo de revisión para su análisis y cierre.</p>
                <form method="post" action="{{ path('app_evento_en_revision', {id: evento.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('en_revision_' ~ evento.id) }}">
                    <button type="submit" class="btn btn-warning btn-sm w-100"
                            onclick="return confirm('¿Poner este evento en revisión?')">
                        <i class="bi bi-arrow-right-circle me-1"></i>Poner en revisión
                    </button>
                </form>
            </div>
        </div>

        {# PASO 2: En revisión → cerrar #}
        {% elseif evento.estado.puedeCerrar() %}
        <div class="card border-0 shadow-sm border-start border-primary border-4 mb-3">
            <div class="card-body py-2 px-3">
                <div class="text-muted small">
                    <i class="bi bi-person-check me-1"></i>
                    En revisión por <strong>{{ evento.revisadoPor ? evento.revisadoPor.nombreCompleto : '—' }}</strong>
                    {% if evento.revisadoEn %}· {{ evento.revisadoEn|date('d/m/Y H:i') }}{% endif %}
                </div>
            </div>
        </div>
        <div class="card border-0 shadow-sm border-start border-success border-4">
            <div class="card-body">
                <h6 class="fw-semibold text-success mb-3"><i class="bi bi-check-circle me-2"></i>Cerrar evento</h6>
                <form method="post" action="{{ path('app_evento_cerrar', {id: evento.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('cerrar_' ~ evento.id) }}">
                    <div class="mb-2">
                        <textarea name="observacion" class="form-control form-control-sm" rows="2"
                                  placeholder="Observación de cierre (obligatorio)..." required></textarea>
                    </div>
                    <button type="submit" class="btn btn-success btn-sm w-100"
                            onclick="return confirm('¿Confirmar cierre del evento?')">
                        <i class="bi bi-check-lg me-1"></i>Cerrar evento
                    </button>
                </form>
            </div>
        </div>

        {# PASO 3: Cerrado — solo lectura #}
        {% else %}
        <div class="card border-0 shadow-sm border-start border-primary border-4 mb-3">
            <div class="card-body py-2 px-3">
                <div class="text-muted small">
                    <i class="bi bi-person-check me-1"></i>
                    Revisado por <strong>{{ evento.revisadoPor ? evento.revisadoPor.nombreCompleto : '—' }}</strong>
                    {% if evento.revisadoEn %}· {{ evento.revisadoEn|date('d/m/Y H:i') }}{% endif %}
                </div>
            </div>
        </div>
        <div class="card border-0 shadow-sm border-start border-success border-4">
            <div class="card-body">
                <h6 class="fw-semibold text-success mb-2"><i class="bi bi-check-circle-fill me-2"></i>Evento cerrado</h6>
                <ul class="list-unstyled small text-muted mb-0">
                    <li><i class="bi bi-person me-1"></i>{{ evento.cerradoPor ? evento.cerradoPor.nombreCompleto : '—' }}</li>
                    <li><i class="bi bi-calendar me-1"></i>{{ evento.fechaCierre ? evento.fechaCierre|date('d/m/Y') : '—' }}</li>
                </ul>
                {% if evento.observacionCierre %}
                <p class="mb-0 small mt-2 border-top pt-2">{{ evento.observacionCierre }}</p>
                {% endif %}
            </div>
        </div>
        {% endif %}
    </div>

    {# Timeline de seguimiento #}
    <div class="col-lg-7">
        {# Agregar seguimiento #}
        {% if evento.estado.value != 'CERRADO' %}
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 fw-semibold py-3">
                <i class="bi bi-plus-circle me-2 text-primary"></i>Agregar seguimiento
            </div>
            <div class="card-body">
                {{ form_start(formSeg, {attr: {novalidate: 'novalidate'}}) }}
                {{ form_row(formSeg.nota) }}
                <button type="submit" class="btn btn-primary btn-sm mt-2">
                    <i class="bi bi-send me-1"></i>Guardar nota
                </button>
                {{ form_end(formSeg) }}
            </div>
        </div>
        {% endif %}

        {# Timeline #}
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 fw-semibold py-3">
                <i class="bi bi-clock-history me-2 text-primary"></i>Historial de seguimiento
            </div>
            <div class="card-body">
                {% set seguimientos = evento.seguimientos|sort((a, b) => b.creadoEn <=> a.creadoEn) %}
                {% if seguimientos|length > 0 %}
                <div class="timeline">
                    {% for seg in seguimientos %}
                    <div class="d-flex gap-3 mb-3">
                        <div class="flex-shrink-0">
                            <div class="bg-primary-subtle rounded-circle d-flex align-items-center justify-content-center"
                                 style="width:36px;height:36px;">
                                <i class="bi bi-chat-text text-primary small"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 border-bottom pb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="fw-semibold small">{{ seg.creadoPor ? seg.creadoPor.nombreCompleto : 'Sistema' }}</span>
                                <span class="text-muted small">{{ seg.creadoEn|date('d/m/Y H:i') }}</span>
                            </div>
                            <p class="mb-0 small">{{ seg.nota }}</p>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <p class="text-muted text-center py-3 mb-0">Sin notas de seguimiento aún.</p>
                {% endif %}
            </div>
        </div>

        {# Metadatos #}
        <div class="mt-3 text-muted small">
            Registrado por {{ evento.creadoPor ? evento.creadoPor.nombreCompleto : '—' }}
            el {{ evento.creadoEn ? evento.creadoEn|date('d/m/Y H:i') : '—' }}
        </div>
    </div>
</div>
{% endblock %}
