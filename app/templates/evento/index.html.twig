{% extends 'base.html.twig' %}
{% block title %}Eventos Adversos{% endblock %}
{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0 fw-bold">Eventos Adversos</h4>
        <small class="text-muted">Registro y seguimiento de incidentes clínicos</small>
    </div>
    <a href="{{ path('app_evento_new') }}" class="btn btn-danger">
        <i class="bi bi-plus-lg me-2"></i>Registrar evento
    </a>
</div>

{# Contadores de estado #}
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <a href="{{ path('app_evento_index', {estado: 'ABIERTO'}) }}" class="text-decoration-none">
            <div class="card border-0 shadow-sm border-start border-danger border-4">
                <div class="card-body d-flex justify-content-between align-items-center py-3">
                    <div>
                        <div class="fs-2 fw-bold text-danger">{{ conteos['ABIERTO'] ?? 0 }}</div>
                        <div class="text-muted small">Abiertos</div>
                    </div>
                    <i class="bi bi-exclamation-triangle fs-2 text-danger opacity-25"></i>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="{{ path('app_evento_index', {estado: 'EN_PROCESO'}) }}" class="text-decoration-none">
            <div class="card border-0 shadow-sm border-start border-warning border-4">
                <div class="card-body d-flex justify-content-between align-items-center py-3">
                    <div>
                        <div class="fs-2 fw-bold text-warning">{{ conteos['EN_PROCESO'] ?? 0 }}</div>
                        <div class="text-muted small">En proceso</div>
                    </div>
                    <i class="bi bi-arrow-repeat fs-2 text-warning opacity-25"></i>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="{{ path('app_evento_index', {estado: 'CERRADO'}) }}" class="text-decoration-none">
            <div class="card border-0 shadow-sm border-start border-success border-4">
                <div class="card-body d-flex justify-content-between align-items-center py-3">
                    <div>
                        <div class="fs-2 fw-bold text-success">{{ conteos['CERRADO'] ?? 0 }}</div>
                        <div class="text-muted small">Cerrados</div>
                    </div>
                    <i class="bi bi-check-circle fs-2 text-success opacity-25"></i>
                </div>
            </div>
        </a>
    </div>
</div>

{# Filtros #}
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-auto">
                <select name="estado" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">Todos los estados</option>
                    {% for e in estados %}
                    <option value="{{ e.value }}" {{ filtroEstado == e.value ? 'selected' : '' }}>{{ e.etiqueta() }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-auto">
                <select name="gravedad" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">Todas las gravedades</option>
                    {% for g in gravedades %}
                    <option value="{{ g.value }}" {{ filtroGravedad == g.value ? 'selected' : '' }}>{{ g.etiqueta() }}</option>
                    {% endfor %}
                </select>
            </div>
            {% if filtroEstado or filtroGravedad %}
            <div class="col-auto">
                <a href="{{ path('app_evento_index') }}" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-x-lg me-1"></i>Limpiar filtros
                </a>
            </div>
            {% endif %}
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Fecha</th>
                        <th>Paciente</th>
                        <th>Tipo</th>
                        <th>Gravedad</th>
                        <th>Estado</th>
                        <th>Trabajador</th>
                        <th class="pe-4 text-end">Ver</th>
                    </tr>
                </thead>
                <tbody>
                {% for evento in pagination %}
                <tr>
                    <td class="ps-4 text-muted small">{{ evento.fechaEvento|date('d/m/Y') }}</td>
                    <td class="fw-semibold">{{ evento.paciente.nombreCompleto }}</td>
                    <td>
                        <i class="bi {{ evento.tipo.icono() }} me-1"></i>
                        <span class="small">{{ evento.tipo.etiqueta() }}</span>
                    </td>
                    <td>
                        <span class="badge {{ evento.gravedad.badgeClass() }}">{{ evento.gravedad.etiqueta() }}</span>
                    </td>
                    <td>
                        <span class="badge {{ evento.estado.badgeClass() }}">{{ evento.estado.etiqueta() }}</span>
                    </td>
                    <td class="text-muted small">{{ evento.trabajador ? evento.trabajador.nombreCompleto : '—' }}</td>
                    <td class="pe-4 text-end">
                        <a href="{{ path('app_evento_show', {id: evento.id}) }}" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-eye"></i>
                        </a>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="7" class="text-center text-muted py-5">
                    <i class="bi bi-shield-check fs-1 opacity-25 d-block mb-2"></i>
                    No hay eventos adversos registrados.
                </td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% if pagination.pageCount > 1 %}
    <div class="card-footer bg-white border-0 d-flex justify-content-center">{{ knp_pagination_render(pagination) }}</div>
    {% endif %}
</div>
{% endblock %}
