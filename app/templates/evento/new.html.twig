{% extends 'base.html.twig' %}
{% block title %}Registrar evento adverso{% endblock %}
{% block content %}
<div class="d-flex align-items-center mb-4 gap-3">
    <a href="{{ path('app_evento_index') }}" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div>
        <h4 class="mb-0 fw-bold">Registrar evento adverso</h4>
        <small class="text-muted">Documente el incidente con todos los detalles disponibles</small>
    </div>
</div>

<div class="card border-0 shadow-sm" style="max-width:800px;">
    <div class="card-body p-4">
        {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
        <div class="row g-3">
            <div class="col-12">{{ form_row(form.paciente) }}</div>
            <div class="col-md-6">{{ form_row(form.trabajador) }}</div>
            <div class="col-md-3">{{ form_row(form.fechaEvento) }}</div>
            <div class="col-md-3">{{ form_row(form.horaEvento) }}</div>
            <div class="col-md-6">{{ form_row(form.tipo) }}</div>
            <div class="col-md-6">{{ form_row(form.gravedad) }}</div>
            <div class="col-12">{{ form_row(form.descripcion) }}</div>
            <div class="col-12">{{ form_row(form.accionesTomadas) }}</div>
            <div class="col-md-6">{{ form_row(form.notificadoFamilia) }}</div>
            <div class="col-md-6">{{ form_row(form.notificadoMedico) }}</div>
        </div>
        <div class="alert alert-warning mt-3 small mb-0">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Los eventos con gravedad <strong>Grave</strong> o <strong>Crítico</strong> enviarán una notificación automática a administradores y coordinadores.
        </div>
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-danger"><i class="bi bi-check-lg me-2"></i>Registrar evento</button>
            <a href="{{ path('app_evento_index') }}" class="btn btn-light">Cancelar</a>
        </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
