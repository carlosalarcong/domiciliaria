{% extends 'base.html.twig' %}
{% block title %}Editar sincronización{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0 fw-bold">{{ sincronizacion.nombre }}</h4>
        <small class="text-muted">Editar sincronización externa</small>
    </div>
    <a href="{{ path('app_sincronizacion_index') }}" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Volver
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        {% include 'sincronizacion/form.html.twig' with {form: form, submit_label: 'Guardar cambios'} %}
    </div>
</div>
{% endblock %}
