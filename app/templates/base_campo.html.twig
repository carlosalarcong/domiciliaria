<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#1a2332">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Mis Turnos">
    <title>{% block title %}Mis Turnos{% endblock %} — Domiciliaria</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🏥</text></svg>">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    {% block stylesheets %}{% endblock %}
    <style>
        :root {
            --campo-primary: #1a2332;
            --campo-accent:  #3182ce;
            --nav-height: 64px;
            --header-height: 56px;
            --safe-top:    env(safe-area-inset-top, 0px);
            --safe-bottom: env(safe-area-inset-bottom, 0px);
        }

        * { -webkit-tap-highlight-color: transparent; }

        body {
            background: #f0f4f8;
            padding-top: calc(var(--header-height) + var(--safe-top));
            padding-bottom: calc(var(--nav-height) + var(--safe-bottom));
            font-size: 1rem;
            overscroll-behavior: none;
        }

        /* ── Top header ── */
        .campo-header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: calc(var(--header-height) + var(--safe-top));
            padding-top: var(--safe-top);
            background: var(--campo-primary);
            color: #fff;
            display: flex;
            align-items: center;
            padding-left: 1rem;
            padding-right: 1rem;
            z-index: 1000;
            gap: 0.75rem;
        }
        .campo-header .brand {
            flex: 1;
            font-weight: 700;
            font-size: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .campo-header .brand small {
            font-weight: 400;
            font-size: 0.75rem;
            color: #a0aec0;
        }
        .campo-header .avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--campo-accent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
            font-weight: 700;
            flex-shrink: 0;
        }

        /* ── Bottom nav ── */
        .campo-bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: calc(var(--nav-height) + var(--safe-bottom));
            padding-bottom: var(--safe-bottom);
            background: #fff;
            border-top: 1px solid #e2e8f0;
            display: flex;
            z-index: 1000;
        }
        .campo-nav-item {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 3px;
            color: #718096;
            text-decoration: none;
            font-size: 0.68rem;
            font-weight: 500;
            transition: color .15s;
            border: none;
            background: none;
            padding: 0;
        }
        .campo-nav-item i { font-size: 1.4rem; }
        .campo-nav-item.active { color: var(--campo-accent); }
        .campo-nav-item:active { opacity: 0.7; }

        /* ── Cards ── */
        .turno-card {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 2px 8px rgba(0,0,0,.08);
            overflow: hidden;
            margin-bottom: 1rem;
            text-decoration: none;
            color: inherit;
            display: block;
            transition: transform .1s, box-shadow .1s;
        }
        .turno-card:active {
            transform: scale(.98);
            box-shadow: 0 1px 4px rgba(0,0,0,.1);
            color: inherit;
        }
        .turno-card-status {
            height: 6px;
        }
        .turno-card-body { padding: 1.1rem 1.1rem 1rem; }

        /* ── Acción buttons ── */
        .btn-campo {
            width: 100%;
            padding: 1rem;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 14px;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.6rem;
            min-height: 60px;
            cursor: pointer;
            transition: opacity .15s, transform .1s;
        }
        .btn-campo:active {
            opacity: 0.85;
            transform: scale(.98);
        }
        .btn-iniciar  { background: #22c55e; color: #fff; }
        .btn-terminar { background: #ef4444; color: #fff; }
        .btn-ver      { background: var(--campo-accent); color: #fff; }

        /* ── Info rows ── */
        .info-row {
            display: flex;
            align-items: flex-start;
            gap: 0.75rem;
            padding: 0.85rem 1rem;
            border-bottom: 1px solid #f0f4f8;
        }
        .info-row:last-child { border-bottom: none; }
        .info-row i {
            font-size: 1.2rem;
            color: #718096;
            flex-shrink: 0;
            margin-top: 1px;
            width: 24px;
            text-align: center;
        }
        .info-row .label { font-size: 0.75rem; color: #718096; margin-bottom: 1px; }
        .info-row .value { font-weight: 500; font-size: 0.95rem; }

        /* ── Flash messages ── */
        .campo-flash {
            margin: 0.75rem;
            border-radius: 12px;
            padding: 0.85rem 1rem;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }

        /* ── Misc ── */
        .time-badge {
            background: #ebf8ff;
            color: #2b6cb0;
            border-radius: 8px;
            padding: 0.25rem 0.6rem;
            font-size: 0.82rem;
            font-weight: 600;
        }
        .estado-pill {
            border-radius: 20px;
            padding: 0.2rem 0.7rem;
            font-size: 0.78rem;
            font-weight: 600;
        }
    </style>
</head>
<body>

{# ── Header ── #}
<header class="campo-header">
    <div class="brand">
        <i class="bi bi-house-heart-fill text-info"></i>
        <div>
            <div>{% block header_title %}Mis Turnos{% endblock %}</div>
            <small>{{ app.user.nombreCompleto ?? app.user.userIdentifier }}</small>
        </div>
    </div>
    <div class="avatar">
        {{ app.user.nombre|first|upper }}{{ app.user.apellido|first|upper }}
    </div>
    <a href="{{ path('app_logout') }}" class="text-white opacity-75" title="Cerrar sesión">
        <i class="bi bi-box-arrow-right fs-5"></i>
    </a>
</header>

{# ── Flash messages ── #}
{% for msg in app.flashes('success') %}
<div class="campo-flash bg-success-subtle text-success">
    <i class="bi bi-check-circle-fill"></i> {{ msg }}
</div>
{% endfor %}
{% for msg in app.flashes('error') %}
<div class="campo-flash bg-danger-subtle text-danger">
    <i class="bi bi-x-circle-fill"></i> {{ msg }}
</div>
{% endfor %}

{# ── Content ── #}
<main class="px-3 pt-3">
    {% block content %}{% endblock %}
</main>

{# ── Bottom nav ── #}
<nav class="campo-bottom-nav">
    <a href="{{ path('app_campo_index') }}"
       class="campo-nav-item {{ app.request.attributes.get('_route') == 'app_campo_index' ? 'active' : '' }}">
        <i class="bi bi-calendar-check"></i>
        <span>Mis Turnos</span>
    </a>
    <a href="{{ path('app_notificacion_index') }}"
       class="campo-nav-item {{ app.request.attributes.get('_route') starts with 'app_notificacion' ? 'active' : '' }}">
        <i class="bi bi-bell"></i>
        <span>Avisos</span>
    </a>
    <a href="{{ path('app_dashboard') }}" class="campo-nav-item">
        <i class="bi bi-grid-3x3-gap"></i>
        <span>Sistema</span>
    </a>
</nav>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
