{% extends 'base.html.twig' %}
{% block title %}Nueva tarifa{% endblock %}
{% block content %}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0 fw-bold">Nueva tarifa</h4>
        <small class="text-muted">Configurar valor por tipo de concepto</small>
    </div>
    <a href="{{ path('app_tarifa_index') }}" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Volver
    </a>
</div>

<div class="card border-0 shadow-sm" style="max-width: 640px;">
    <div class="card-body p-4">
        {{ form_start(form) }}
        <div class="row g-3">
            <div class="col-12">{{ form_row(form.mandante) }}</div>
            <div class="col-md-6">{{ form_row(form.tipoConcepto) }}</div>
            <div class="col-md-6">{{ form_row(form.valorUnitario) }}</div>
            <div class="col-md-6">{{ form_row(form.vigenciaDesde) }}</div>
            <div class="col-md-6">{{ form_row(form.vigenciaHasta) }}</div>
            <div class="col-12">{{ form_row(form.descripcion) }}</div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-1"></i>Guardar tarifa
            </button>
            <a href="{{ path('app_tarifa_index') }}" class="btn btn-outline-secondary">Cancelar</a>
        </div>
        {{ form_end(form) }}
    </div>
</div>

{% endblock %}
