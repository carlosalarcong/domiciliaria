{% extends 'base.html.twig' %}

{% block title %}Nuevo Usuario{% endblock %}

{% block content %}
<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_user_index') }}">Usuarios</a></li>
            <li class="breadcrumb-item active">Nuevo usuario</li>
        </ol>
    </nav>
    <h4 class="mb-0 fw-bold">Crear nuevo usuario</h4>
</div>

<div class="row">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">{{ form_label(form.nombre) }}</label>
                        {{ form_widget(form.nombre) }}
                        {{ form_errors(form.nombre) }}
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">{{ form_label(form.apellido) }}</label>
                        {{ form_widget(form.apellido) }}
                        {{ form_errors(form.apellido) }}
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">{{ form_label(form.email) }}</label>
                        {{ form_widget(form.email) }}
                        {{ form_errors(form.email) }}
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">{{ form_label(form.roles) }}</label>
                        {{ form_widget(form.roles) }}
                        {{ form_help(form.roles) }}
                        {{ form_errors(form.roles) }}
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">{{ form_label(form.plainPassword.first) }}</label>
                        {{ form_widget(form.plainPassword.first) }}
                        {{ form_errors(form.plainPassword.first) }}
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">{{ form_label(form.plainPassword.second) }}</label>
                        {{ form_widget(form.plainPassword.second) }}
                        {{ form_errors(form.plainPassword.second) }}
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            {{ form_widget(form.activo) }}
                            <label class="form-check-label fw-semibold" for="{{ form.activo.vars.id }}">
                                {{ form_label(form.activo) }}
                            </label>
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-person-plus me-2"></i>Crear usuario
                    </button>
                    <a href="{{ path('app_user_index') }}" class="btn btn-outline-secondary">Cancelar</a>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
