{% extends 'base.html.twig' %}

{% block title %}Editar {{ usuario.nombreCompleto }}{% endblock %}

{% block content %}
<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_user_index') }}">Usuarios</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_user_show', {id: usuario.id}) }}">{{ usuario.nombreCompleto }}</a></li>
            <li class="breadcrumb-item active">Editar</li>
        </ol>
    </nav>
    <h4 class="mb-0 fw-bold">Editar usuario</h4>
</div>

<div class="row">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Nombre</label>
                        {{ form_widget(form.nombre) }}
                        {{ form_errors(form.nombre) }}
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Apellido</label>
                        {{ form_widget(form.apellido) }}
                        {{ form_errors(form.apellido) }}
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Email</label>
                        {{ form_widget(form.email) }}
                        {{ form_errors(form.email) }}
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Roles</label>
                        {{ form_widget(form.roles) }}
                        {{ form_help(form.roles) }}
                        {{ form_errors(form.roles) }}
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            {{ form_widget(form.activo) }}
                            <label class="form-check-label fw-semibold" for="{{ form.activo.vars.id }}">
                                {{ form_label(form.activo) }}
                            </label>
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-2"></i>Guardar cambios
                    </button>
                    <a href="{{ path('app_user_show', {id: usuario.id}) }}" class="btn btn-outline-secondary">Cancelar</a>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
        <div class="card border-0 shadow-sm mt-3">
            <div class="card-header bg-white border-0">
                <h6 class="mb-0 fw-semibold text-warning"><i class="bi bi-key me-2"></i>Cambiar contraseña</h6>
            </div>
            <div class="card-body">
                <a href="{{ path('app_user_change_password', {id: usuario.id}) }}" class="btn btn-warning btn-sm">
                    <i class="bi bi-key me-2"></i>Cambiar contraseña
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
