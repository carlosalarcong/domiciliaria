{% extends 'base.html.twig' %}
{% block title %}Notificaciones{% endblock %}
{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0 fw-bold">Notificaciones</h4>
        <small class="text-muted">
            {% if totalNoLeidas > 0 %}
                {{ totalNoLeidas }} sin leer
            {% else %}
                Todo al día
            {% endif %}
        </small>
    </div>
    {% if totalNoLeidas > 0 %}
    <form method="post" action="{{ path('app_notificacion_leer_todas') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('notif_leer_todas') }}">
        <button type="submit" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-check2-all me-1"></i>Marcar todas como leídas
        </button>
    </form>
    {% endif %}
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        {% if notificaciones is empty %}
            <div class="text-center text-muted py-5">
                <i class="bi bi-bell-slash fs-1 opacity-25 d-block mb-2"></i>
                Sin notificaciones recientes.
            </div>
        {% else %}
            <ul class="list-group list-group-flush">
            {% for notif in notificaciones %}
                <li class="list-group-item px-4 py-3 {{ not notif.leida ? 'bg-primary-subtle' : '' }}">
                    <div class="d-flex align-items-start gap-3">
                        <div class="flex-shrink-0 pt-1">
                            <i class="bi {{ notif.icono() }} fs-5"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start">
                                <span class="fw-semibold {{ not notif.leida ? '' : 'text-muted' }}">
                                    {{ notif.titulo }}
                                </span>
                                <span class="text-muted small ms-3 flex-shrink-0">
                                    {{ notif.creadoEn|date('d/m H:i') }}
                                </span>
                            </div>
                            {% if notif.cuerpo %}
                                <div class="small text-muted">{{ notif.cuerpo }}</div>
                            {% endif %}
                        </div>
                        {% if not notif.leida %}
                        <div class="flex-shrink-0">
                            <form method="post" action="{{ path('app_notificacion_leer', {id: notif.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('notif_leer') }}">
                                <button type="submit" class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size:.75rem">
                                    {{ notif.url ? 'Ver' : 'Leída' }}
                                </button>
                            </form>
                        </div>
                        {% elseif notif.url %}
                        <div class="flex-shrink-0">
                            <a href="{{ notif.url }}" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size:.75rem">Ver</a>
                        </div>
                        {% endif %}
                    </div>
                </li>
            {% endfor %}
            </ul>
        {% endif %}
    </div>
</div>
{% endblock %}
